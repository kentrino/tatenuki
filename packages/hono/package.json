  },
  "devDependencies": {
    "@types/node": "catalog:",
    "hono": "catalog:",
    "tatenuki": "workspace:*",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "tatenuki": "^0.2.0"
