{
  "name": "@tatenuki/hono",
  "version": "0.3.0",
  "description": "Hono request-scope middleware for tatenuki.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentrino/tatenuki.git",
    "directory": "packages/hono"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
