{
  "name": "tatenuki",
  "version": "0.1.0",
  "description": "A small, typed dependency-injection container for composition roots.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "bench:get": "vp test bench src/get.bench.ts --run",
    "bench:resolve": "vp test bench src/resolve.bench.ts --run",
    "check": "vp check",
    "test": "vp test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8"
  }
}
